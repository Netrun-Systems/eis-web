# EISWeb environment (copy to .env)

# Absolute path to a working clone of the EISCORE repo. The WEB-003 API server
# reads/writes CSVs, runs the repo's Python validators, and commits against
# this clone — files + git are the store. The path must contain Data/ and
# Exports/TableManifest.json (generate the latter with
# `python Scripts/export_table_manifest.py` in EISCORE).
#EISCORE_REPO_PATH=C:\Users\Daniel\Documents\Unreal Projects\EISCORE

# Port for the WEB-003 API server (npm run dev:api).
#API_PORT=3001
