# EISWeb environment (copy to .env; none of these are required for `npm run dev` yet)

# Absolute path to a working clone of the EISCORE repo.
# Used from WEB-003 on: the API server reads/writes CSVs and runs
# validators against this clone. Files + git are the store.
#EISCORE_REPO_PATH=

# Port for the WEB-003 API server.
#API_PORT=3001
